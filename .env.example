# Personal AI Agent Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=Personal AI Agent
APP_VERSION=0.1.0
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/agent.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/agent.log

# Model Provider (gemini, nemotron, openai, anthropic)
MODEL_PROVIDER=gemini

# Nemotron / OpenAI-compatible settings
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_API_KEY=your-api-key-here
MODEL_NAME=nvidia/nemotron-3-ultra
MODEL_TIMEOUT=120
MODEL_MAX_TOKENS=8192
MODEL_TEMPERATURE=0.1

# Gemini settings
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=60
GEMINI_MAX_RETRIES=3

# Browser
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
BROWSER_USER_DATA_DIR=./data/browser_profile

# File System
ALLOWED_DIRECTORIES=./data/workspace
MAX_FILE_SIZE_MB=50

# Task Limits
MAX_TASK_DURATION_SECONDS=3600
MAX_TOOL_CALLS_PER_TASK=100
MAX_RETRIES=3

# Approval
APPROVAL_REQUIRED_FOR_LEVEL2=true
APPROVAL_REQUIRED_FOR_LEVEL3=true
APPROVAL_TIMEOUT_SECONDS=300

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_CHECK_INTERVAL_SECONDS=60

# Memory
MEMORY_ENABLED=true
MEMORY_MAX_ITEMS=1000

# Telemetry
TELEMETRY_ENABLED=false

# Master Password for Secret Encryption (optional)
# AGENT_MASTER_PASSWORD=your-secure-password